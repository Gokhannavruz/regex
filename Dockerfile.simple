# Simple frontend Dockerfile without build issues
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Serve with a simple HTTP server
EXPOSE 3000
CMD ["npx", "serve", "-s", "dist", "-l", "3000"]
