## 8️⃣ FRONTEND INTEGRATION

### API Service (frontend/src/services/api.js)

```javascript
const API_BASE = process.env.REACT_APP_API_URL || 'http://localhost:5000/api';

export const testRegex = async (pattern, flags, testString, language) => {
    const response = await fetch(`${API_BASE}/regex/test`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pattern, flags, testString, language })
    });
    return response.json();
};

export const generateRegex = async (description, language) => {
    const token = localStorage.getItem('token');
    const response = await fetch(`${API_BASE}/ai/generate`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ description, language })
    });
    return response.json();
};

export const saveRegex = async (data) => {
    const token = localStorage.getItem('token');
    const response = await fetch(`${API_BASE}/regex/save`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify(data)
    });
    return response.json();
};
```

